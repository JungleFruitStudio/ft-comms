{
  "cleanUrls": true,
  "functions": { "api/send.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)\\.(html|js|mjs|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
